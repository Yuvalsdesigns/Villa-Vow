rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isWeddingUser() {
      return request.auth != null
        && request.auth.token.email in [
          'yuvalsh99@gmail.com',
          'yohan-levy@hotmail.fr',
          'yohan.yuval@gmail.com'
        ];
    }
    /* Budget, the guest list (and the invoice files and budget goal that
       go with them), and the private notes-to-each-other stay wedding-
       accounts-only to read. Everything else (checklist, venues, style
       gallery, moodboard, email templates, DIY, travel guide) is public
       to view - no sign-in needed - matching app-1.js's client-side tab
       hiding and read-only lockdown for the same collections. Writes
       anywhere always require a wedding account.
       Note: this must stay a single rule per path rather than one broad
       "allow read: if true" plus narrower exceptions - Firestore grants
       access if ANY matching rule allows it, so a separate broad rule
       would silently make these public again regardless of this one. */
    function isPrivateDoc(coll, id) {
      return coll in ['budget', 'guests', 'invoiceFiles', 'loveNotes']
        || (coll == 'meta' && id == 'budgetGoal');
    }

    match /{collection}/{docId} {
      allow read: if isWeddingUser() || !isPrivateDoc(collection, docId);
      allow write: if isWeddingUser();
    }

    /* A moodboard pin kept private to one specific wedding account (e.g. a
       wedding dress pin meant as a surprise from the groom) lives here,
       one level under that account's own email, instead of as a flagged
       document inside the shared pinboard collection above - that was the
       first version of this and it did not work: Firestore only enforces
       a per-document condition (like a privateToEmail field checked
       against resource.data) for a direct get() of one already-known
       document. The moodboard's own listener is a live LIST query over
       the whole collection, and confirmed against a real Firestore
       emulator, a list query simply ignores a resource.data condition
       like that and returns every document regardless of it - so every
       "private" pin was actually visible to anyone the whole time this
       rule was live. A path segment, by contrast, is something Firestore
       always enforces correctly for a list query, the same way every
       other privacy boundary in this file already does - so that's what
       actually decides visibility here, not a field. */
    match /privatePins/{owner}/items/{docId} {
      allow read, write: if isWeddingUser() && request.auth.token.email == owner;
    }
  }
}
